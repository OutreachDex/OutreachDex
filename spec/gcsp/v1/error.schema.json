{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://globalcontact.dev/spec/gcsp/v1/error.schema.json",
  "title": "GCSP/1 error",
  "type": "object",
  "required": ["error"],
  "properties": {
    "error": {
      "type": "object",
      "required": ["code", "message"],
      "properties": { "code": { "type": "string" }, "message": { "type": "string" } }
    }
  }
}
