{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://globalcontact.dev/spec/gcsp/v1/page.schema.json",
  "title": "GCSP/1 page of people or events",
  "type": "object",
  "required": ["items", "next_cursor", "has_more"],
  "properties": {
    "items": { "type": "array" },
    "next_cursor": { "type": ["string", "null"] },
