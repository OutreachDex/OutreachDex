{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OutreachDex",
  "version": "0.1.1",
  "identifier": "com.outreachdex.desktop",
  "build": {
    "beforeDevCommand": "pnpm web:dev",
    "beforeBuildCommand": "pnpm web:build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../web/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OutreachDex",
        "width": 1440,
        "height": 920,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; worker-src 'self' blob:; frame-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "resources": [
      "resources/"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk1RDdCRjc3RTVGQjY3MTIKUldRU1ovdmxkNy9YbFJHd2tqVkFMY0V0WS9QdUNKRVU5WFl4Rkx4SXlvQXFnYlRZTlZ1U25RWmoK",
      "endpoints": [
        "https://github.com/OutreachDex/OutreachDex/releases/latest/download/latest.json"
      ]
    }
  }
}
